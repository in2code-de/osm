plugin.tx_osm {
  # cat=osm; type=boolean; label= Enable alternative frontend templates with an updated OpenLayers library
  enableOpenLayers10 = 0

  settings {
    # cat=osm; type=string; label= URI template for OpenStreetMap tile servers (alternative frontend templates only)
    tileServerUriTemplate = https://{a-c}.tile.openstreetmap.org/{z}/{x}/{y}.png
  }
}
