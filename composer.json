{
	"name": "in2code/osm",
	"description": "OSM - OpenStreetMap extension for TYPO3",
	"keywords": [
		"typo3",
		"osm",
		"OpenStreetMap"
	],
	"homepage": "https://github.com/in2code-de/osm",
	"authors": [
		{
			"name": "Alex Kellner",
			"email": "alexander.kellner@in2code.de",
			"role": "Technical owner",
			"homepage": "https://www.in2code.de"
		}
	],
	"type": "typo3-cms-extension",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": "^8.2",
		"typo3/cms-core": "^12.4 || ^13.4",
		"ext-json": "*"
	},
	"replace": {
		"typo3-ter/osm": "self.version"
	},
	"suggest": {
		"friendsoftypo3/tt-address": "Show address markers from tt_address records in a map"
	},
	"autoload": {
		"psr-4": {
			"In2code\\Osm\\": "Classes/"
		}
	},
	"config": {
		"vendor-dir": ".build/vendor",
		"bin-dir": ".build/bin",
		"sort-packages": true,
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true
		}
	},
	"extra": {
		"typo3/cms": {
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"web-dir": ".build/public",
			"extension-key": "osm"
		}
	},
	"require-dev": {
		"ssch/typo3-rector": "^3.0",
		"typo3/cms-backend": "^13.4",
		"typo3/cms-extbase": "^13.4",
		"typo3/cms-extensionmanager": "^13.4",
		"typo3/cms-filelist": "^13.4",
		"typo3/cms-fluid": "^13.4",
		"typo3/cms-fluid-styled-content": "^13.4",
		"typo3/cms-frontend": "^13.4",
		"typo3/cms-install": "^13.4",
		"typo3/minimal": "^13"
	},
	"scripts": {
		"test:rector": "rector -n",
		"test:rector:fix": "rector"
	}
}
